{
    "solver": "GPUHybrid",
    "GPUHybrid": {
        "max_iter": 10000,
        "relative_tolerance": 1e-12,
        "absolute_tolerance": 0,
        "block_size": 1,
        "theta": 0.5,
        "do_hybrid_precond": true,
        "select_bad_dofs_from_l1_norm": false,
        "decompose_subdomains": true,
        "min_subdomain_size": 4,
        "expand_subdomains": false,
        "max_dense_size": 0
    }
}